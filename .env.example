# Copy to .env for local development and fill in real values.
# .env is gitignored; on Railway set these same names as service variables
# instead (Service -> Variables), because Railway never sees this file.

# Resend API key, from https://resend.com/api-keys . Sending only needs a key
# with "Sending access".
RESEND_API_KEY=re_your_api_key_here

# Where contact form submissions are delivered.
CONTACT_TO_ADDRESS=you@example.com
